{
  "compilerOptions": {
    "target": "ES2020",
    /* The engine classes assign every field in the constructor body, never as a
       class field. Converting them to TS means declaring those fields for the
       type checker only -- and under `define` semantics a declaration with no
       initializer emits defineProperty(this, x, undefined), which runs before
       the subclass constructor body and would wipe values set via super().
       `false` erases bare declarations instead, matching the JS they replace.
       Nothing here relies on `define`: there are no class fields with
       initializers, and the React layer is entirely function components. */
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* src/ is entirely TypeScript. Leaving allowJs off means a .js file added
       back under src/ fails the build rather than silently opting out of
       type checking. The Playwright specs and playwright.config.js stay
       JavaScript, and are outside `include` below. */
    "allowJs": false
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
